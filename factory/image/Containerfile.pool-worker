# Omarchy Pool Worker — a project worker in a container.
#
# What a maintainer's machine runs to do the project's work: the pool's own
# jobs (sync, promote, health, security, gc, the PKGBUILD reconcile) and the
# rebuild of packages maintainers approved. It holds `pkg-repo work` and the
# tools its jobs need; every build and every check still happens in a
# fresh Arch container, started as a *sibling* through the container
# runtime the operator mounts (Docker Desktop's socket, or Podman's).
#
# The image carries no key and no pool credential: the pool signs, and the
# worker's own token (POST /api/v1/factory/workers, trusted by a maintainer)
# only claims — each task runs with the per-job token the claim issues.
#
# Two things the operator provides (docs: /docs/workers):
#   -v /var/run/docker.sock:/var/run/docker.sock       Docker Desktop, or Podman's socket at that path
#   -v <dir>:<dir> -e OMARCHY_WORK_DIR=<dir>            the SAME path on the host and here: builds are
#                                                       sibling containers that mount subdirectories of it
#
# Built for both architectures by the release workflow (tag = the pool's
# release), signed with cosign (keyless, GitHub OIDC): verify with
#   cosign verify ghcr.io/firemanxbr/omarchy-pool-worker:latest \
#     --certificate-identity-regexp 'github.com/firemanxbr/omarchy-pool' \
#     --certificate-oidc-issuer https://token.actions.githubusercontent.com
ARG BASE=docker.io/library/archlinux:base
FROM ${BASE}
ARG ARCH=x86_64
ARG POOL_RELEASE
ARG DOCKER_CLI=27.5.1
LABEL org.opencontainers.image.source="https://github.com/firemanxbr/omarchy-pool" \
      org.opencontainers.image.description="Omarchy Pool Worker: a project worker that runs the pool's jobs and rebuilds approved packages" \
      org.opencontainers.image.licenses="MIT"
# pacman's download sandbox needs privileges a container build does not have.
RUN sed -i '0,/^\[options\]/s//[options]\nDisableSandboxSyscalls\nDisableSandboxFilesystem/' /etc/pacman.conf \
 && pacman -Syu --noconfirm --needed git curl jq python libarchive gnupg bash ca-certificates && pacman -Scc --noconfirm
# The docker CLI, static: it talks to whatever Docker-compatible socket is mounted at /var/run/docker.sock.
RUN curl -fsSL "https://download.docker.com/linux/static/stable/${ARCH}/docker-${DOCKER_CLI}.tgz" | tar -xz --strip-components=1 -C /usr/local/bin docker/docker
# The pool's tools, from the release this image is tagged with.
RUN set -eu; name="omarchy-pool-${POOL_RELEASE}-${ARCH}-linux"; \
    curl -fsSL -o /tmp/tools.tgz "https://github.com/firemanxbr/omarchy-pool/releases/download/${POOL_RELEASE}/${name}.tar.gz"; \
    curl -fsSL -o /tmp/tools.tgz.sha256 "https://github.com/firemanxbr/omarchy-pool/releases/download/${POOL_RELEASE}/${name}.tar.gz.sha256"; \
    cd /tmp && echo "$(cut -d' ' -f1 tools.tgz.sha256)  tools.tgz" | sha256sum -c -; \
    tar -xzf /tmp/tools.tgz -C /tmp && install -m 755 "/tmp/${name}"/pkg-repo "/tmp/${name}"/omarchy-cli "/tmp/${name}"/pkg-extract /usr/local/bin/ && rm -rf /tmp/tools.tgz* "/tmp/${name}"
ENV OMARCHY_API=https://pkgs.firemanxbr.org OMARCHY_POOL=https://pool.firemanxbr.org \
    OMARCHY_WORK_DIR=/var/lib/omarchy-worker DOCKER_HOST=unix:///var/run/docker.sock
VOLUME /var/lib/omarchy-worker
ENTRYPOINT ["pkg-repo", "work"]
